{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug monoflow2",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/monoflow2.ts",
        "thecatwasoldandhappy",
        "--cycles=2"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
